---
import ContentContainer from '@/components/layouts/ContentContainer.astro';
import EnergyCalculationPage from '@/components/layouts/EnergyCalculationPage.astro';
import StickyContainer from '@/components/layouts/StickyContainer.astro';
import { Typography } from '@/components/ui/typography';
import i18next from 'i18next';
import { AlertCircle } from 'lucide-react';
import BuildingAddress from '../BuildingAddress';
import CurrentStats from '../CurrentStats';
import GeneralDataButtonBar from './GeneralDataButtonBar';
import GeneralDataStepForm from './GeneralDataStepForm';
---

<EnergyCalculationPage step={2}>
  <ContentContainer>
    <Typography variant="h2">
      {i18next.t('energyCalculation:generalData.title')}
    </Typography>
    <BuildingAddress client:load />
    <div class="border-primary mt-4 flex gap-2 border-2 p-3">
      <AlertCircle
        className="text-primary shrink-0 cursor-pointer"
        style={{
          width: 'clamp(20px, calc(16px + 1vw), 24px)',
          height: 'clamp(20px, calc(16px + 1vw), 24px)',
        }}
      />
      <Typography variant="small">
        {i18next.t('energyCalculation:generalData.dataSourceRemark')}
      </Typography>
    </div>
  </ContentContainer>
  <StickyContainer>
    <CurrentStats client:load />
    <div class="mt-4">
      <Typography variant="small">
        {i18next.t('energyCalculation:generalData.statsRemark')}
      </Typography>
    </div>
  </StickyContainer>
  <ContentContainer>
    <GeneralDataStepForm client:load />
    <GeneralDataButtonBar className="mt-8" client:load />
  </ContentContainer>
</EnergyCalculationPage>
