---
import '@/styles/global.css';

interface Props {
  includeCesium?: boolean;
}

const { includeCesium = true } = Astro.props;
---

<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digitaler Energie Zwilling Regensburg</title>
    <link rel="icon" href="/favicon.ico" />
    {includeCesium && <script src="/cesium/Cesium.js" is:inline />}
  </head>
  <body class="flex flex-col">
    <slot />
  </body>
</html>
