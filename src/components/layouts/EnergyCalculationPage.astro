---
interface Props {
  step: number | number[];
  class?: string;
}
const { step, class: className = '' } = Astro.props;
const stepGate = Array.isArray(step) ? step.join(',') : String(step);
---

<section
  data-step-gate={stepGate}
  style="display:none"
  class={`bg-background z-20 flex min-h-full flex-col px-gutter ${className}`}
>
  <div
    class={`mx-auto flex w-full max-w-content flex-col ${step === 7 ? 'gap-12' : 'gap-8'} py-6`}
  >
    <slot />
  </div>
</section>
