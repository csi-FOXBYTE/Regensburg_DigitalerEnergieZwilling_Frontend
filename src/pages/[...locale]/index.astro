---
import MapSection from '@/feature/map/MapSection.astro';
import type { GetStaticPaths } from 'astro';
import DETLayout from '@/components/layouts/DETLayout.astro';
import { buildStaticPaths } from 'astro-react-i18next/utils';
import LandingPage from '@/feature/landingPage/LandingPage.astro';
import GeneralDataStep from '@/feature/energyCalculation/general/GeneralDataStep.astro';
import OuterPartsStep from '@/feature/energyCalculation/outer/OuterPartsStep.astro';
import HeatStep from '@/feature/energyCalculation/heat/HeatStep.astro';
import ElectricityStep from '@/feature/energyCalculation/electricity/ElectricityStep.astro';
import RenovationStep from '@/feature/energyCalculation/renovation/RenovationStep.astro';
import Result from '@/feature/energyCalculation/result/Result.astro';
import DevPanel from '@/dev/DevPanel';
import SessionResumeDialog from '@/feature/map/SessionResumeDialog';

export const getStaticPaths = (() => {
  return buildStaticPaths();
}) satisfies GetStaticPaths;
---

<script>
  import '@/lib/state/session/auto-save';
  import { $step, setStep, navigateToStep, Step } from '@/lib/state/ui/progress';
  import { loadSession, loadSessionFromData, markRestoredFromLink } from '@/lib/state/session';

  const _params = new URLSearchParams(window.location.search);

  const _restoreParam = _params.get('restore');
  if (_restoreParam) {
    markRestoredFromLink();
    _params.delete('restore');
    history.replaceState(null, '', _params.toString() ? `?${_params}` : window.location.pathname);
    try {
      const _session = JSON.parse(decodeURIComponent(atob(_restoreParam)));
      if (_session?.building?.id) {
        loadSessionFromData(_session);
      } else {
        loadSession(_restoreParam);
      }
    } catch {
      loadSession(_restoreParam);
    }
  }


  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-next-step]')) {
      navigateToStep($step.get() + 1);
    }
  });
  window.addEventListener('popstate', (e) => {
    const prevStep = $step.get();
    const step: Step = e.state?.step ?? Step.Welcome;
    if (prevStep !== step) setStep(step);
    if (prevStep >= Step.GeneralData && step < Step.GeneralData) {
      history.pushState({ step }, '');
    }
  });
</script>

<DETLayout>
  <LandingPage />
  <MapSection />
  <GeneralDataStep />
  <OuterPartsStep />
  <HeatStep />
  <ElectricityStep />
  <RenovationStep />
  <Result />
  <SessionResumeDialog client:only="react" />
  {import.meta.env.DEV && <DevPanel client:load />}
</DETLayout>
